# Copia questo file in ".env" per lo sviluppo locale con l'emulatore.
# In produzione questi valori NON vanno mai messi in un file .env committato:
# usare Secret Manager di Firebase (`firebase functions:secrets:set NOME`) e
# dichiararli nella funzione con `defineSecret`.

# Provider email transazionale (SendGrid / Resend / Mailgun). Lasciare vuoto in
# locale: senza questa chiave viene usato automaticamente EmailSender "console"
# (logga l'email invece di inviarla davvero) — vedi src/lib/email.ts.
ESP_API_KEY=

# Mittente delle email di sistema. Dominio placeholder: da sostituire con un
# dominio reale verificato (SPF/DKIM) prima del go-live in produzione.
EMAIL_FROM=mensa@esempio.it
