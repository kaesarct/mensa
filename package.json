{
  "name": "mensa",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "web",
    "functions",
    "firestore-tests",
    "scripts"
  ],
  "scripts": {
    "dev:web": "npm run start --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:functions": "npm run build --workspace=functions",
    "emulators": "firebase emulators:start",
    "emulators:export": "firebase emulators:start --export-on-exit=./.emulator-data --import=./.emulator-data",
    "seed": "npm run seed --workspace=scripts",
    "test:rules": "npm run test --workspace=firestore-tests"
  },
  "devDependencies": {
    "firebase-tools": "^15.15.0"
  }
}
